# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                     <mnt_point>  <type>  <mnt_flags and options>                             <fs_mgr_flags>
system                                      /system      ext4    ro,barrier=0                                        wait,logical,first_stage_mount
system_ext                                  /system_ext  ext4    ro,barrier=0                                        wait,logical,first_stage_mount
vendor                                      /vendor      ext4    ro,barrier=0                                        wait,logical,first_stage_mount
vendor_dlkm                                 /vendor_dlkm ext4    ro,barrier=0                                        wait,logical,first_stage_mount
odm                                         /odm         ext4    ro,barrier=0                                        wait,logical,first_stage_mount
odm_dlkm                                    /odm_dlkm    ext4    ro,barrier=0                                        wait,logical,first_stage_mount
product                                     /product     ext4    ro,barrier=0                                        wait,logical,first_stage_mount
/dev/block/by-name/metadata                /metadata    ext4    nodev,noatime,nosuid,discard,sync                   wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata                /data        ext4    noatime,nodiratime,nosuid,nodev,discard,nodelalloc  wait,check,formattable,quota
/devices/platform/*.usb/usb*               auto         auto    defaults                                            voldmanaged=usb:auto
